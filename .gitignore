# ============================================================
# .gitignore — files Git should NEVER track
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Databases (local dev) ---
*.db
*.sqlite
*.sqlite3

# --- Uploaded files (local dev) ---
backend/uploads/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test coverage ---
coverage/
htmlcov/
.coverage
# --- Test files ---
test-upload.*
make_org.py

