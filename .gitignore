# ============================================================
# .gitignore — files Git should NEVER track
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Databases (local dev) ---
*.db
*.db.bak_*
*.sqlite
*.sqlite3

# --- Uploaded files (local dev) ---
backend/uploads/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test coverage ---
coverage/
htmlcov/
.coverage
# --- Test files ---
test-upload.*
make_org.py


# --- Stray files ---
backend/src/

# Throwaway diagnostic / smoke-test scripts (not part of the app)
/backend/check_*.py
!/backend/check_parity.py
/backend/smoke_*.py

# Throwaway patch scripts (master doc rebuilds, one-off fixes)
/backend/patch_master*.py
/backend/rebuild_master*.py

# Throwaway master-doc scripts (regenerated per session)
/backend/update_master*.py
/backend/fix_*.py
/backend/add_*.py
/backend/patch_*.py
/backend/rebuild_*.py

# Backups
*.backup-*
*.backup
*.bak

# One-off scripts
update_*.py
fix_*.py
rebuild_*.py
patch_*.py
add_*.py

deploy/staging/.env
