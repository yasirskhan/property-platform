ENVIRONMENT=staging
# Copy to deploy/staging/.env. Never commit the real .env file.
POSTGRES_DB=property_platform_staging
POSTGRES_USER=property_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate strong independent secrets for staging.
SECRET_KEY=replace-with-a-long-random-jwt-secret
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

EMAIL_MODE=console
STRIPE_ENABLED=false
FRONTEND_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000